{
  "models": [
    {
      "name": "ByteDance Seedream V4.5 Edit",
      "endpoint_id": "fal-ai/bytedance/seedream/v4.5/edit",
      "mode": "image-to-image",
      "parameters": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "image_urls": {
          "type": "array<string>",
          "required": true,
          "max_items": 10,
          "notes": "If more than 10 images are supplied, only the last 10 are used."
        },
        "image_size": {
          "type": "ImageSize | enum",
          "required": false,
          "allowed_values": [
            "square_hd",
            "square",
            "portrait_4_3",
            "portrait_16_9",
            "landscape_4_3",
            "landscape_16_9",
            "auto_2K",
            "auto_4K"
          ],
          "constraints": {
            "width_min": 1920,
            "width_max": 4096,
            "height_min": 1920,
            "height_max": 4096,
            "total_pixels_min": "2560*1440",
            "total_pixels_max": "4096*4096"
          }
        },
        "num_images": {
          "type": "integer",
          "required": false,
          "default": 1,
          "min": 1,
          "max": 6
        },
        "max_images": {
          "type": "integer",
          "required": false,
          "default": 1,
          "min": 1,
          "max": 6,
          "notes": "Enables multi-image generation when greater than 1. Total image inputs + outputs must not exceed 15."
        },
        "seed": {
          "type": "integer",
          "required": false
        },
        "sync_mode": {
          "type": "boolean",
          "required": false,
          "default": false
        },
        "enable_safety_checker": {
          "type": "boolean",
          "required": false,
          "default": true
        }
      }
    },
